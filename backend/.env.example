# ---------------------------------------------------------------------------
# Backend settings - copy this file to "backend/.env" and fill in what you need.
#   Windows:      copy .env.example .env
#   macOS/Linux:  cp .env.example .env
# Every setting is OPTIONAL. With everything empty the app runs fully offline.
# Restart the backend (uvicorn) after changing this file.
# ---------------------------------------------------------------------------

# --- Optional LLM integration -------------------------------------------------
# Which provider to use: gemini | openai | anthropic | off   (empty = auto/offline)
#   example:  LLM_PROVIDER=gemini
LLM_PROVIDER=

# API key for the provider you chose - only that one is needed.
#   Gemini  -> https://aistudio.google.com/app/apikey
#              example:  GEMINI_API_KEY=
#   OpenAI  -> https://platform.openai.com/api-keys
#              example:  OPENAI_API_KEY=sk-...
#   Claude  -> https://console.anthropic.com/settings/keys
#              example:  ANTHROPIC_API_KEY=...
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional model override (leave empty for the default).
#   defaults: gemini-2.5-flash | gpt-4o-mini | claude-opus-5-5
#   example:  LLM_MODEL=gemini-2.5-pro
LLM_MODEL=

# --- Storage --------------------------------------------------------------------
# SQLite file for decision history and chat sessions (relative to backend/).
#   default:  data/neurosymbolic.db
NS_DB_PATH=
