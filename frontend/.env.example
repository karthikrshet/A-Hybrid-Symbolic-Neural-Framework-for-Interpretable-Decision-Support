# ---------------------------------------------------------------------------
# Frontend settings - copy this file to "frontend/.env.local" and edit.
#   Windows:      copy .env.example .env.local
#   macOS/Linux:  cp .env.example .env.local
# OPTIONAL: only needed if the backend is NOT at http://localhost:8000.
# Restart "npm run dev" after changing it.
# ---------------------------------------------------------------------------

# URL of the FastAPI backend used by the browser
NEXT_PUBLIC_API_URL=http://localhost:8000
