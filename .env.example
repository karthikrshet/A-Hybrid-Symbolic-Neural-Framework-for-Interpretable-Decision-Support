# Backend (optional) - where the SQLite history database is stored
NS_DB_PATH=backend/data/neurosymbolic.db

# Optional LLM integration (can also be set in the chat's "Connect LLM" dialog)
# LLM_PROVIDER=gemini            # gemini | openai | anthropic
# LLM_MODEL=                     # optional override
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Frontend (frontend/.env.local) - backend URL used by the browser
NEXT_PUBLIC_API_URL=http://localhost:8000
